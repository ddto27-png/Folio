{
  "expo": {
    "name": "Folio",
    "slug": "folio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#F8F4EE"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.folio.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F8F4EE"
      },
      "package": "com.folio.app"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "scheme": "folio",
    "plugins": ["expo-router"]
  }
}
